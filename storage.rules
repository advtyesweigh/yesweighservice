rules_version = '2';
// CI smoke-test marker — 2026-06-26

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().role;
    }

    function isSuperAdmin() {
      return signedIn() && userExists() && (role() == 'super_admin' || role() == 'admin');
    }

    function isFullSuperAdmin() {
      return isSuperAdmin() && (
        !userDoc().keys().hasAny(['superAdminAccess'])
        || userDoc().superAdminAccess != 'view_only'
      );
    }

    function validPurchaseOrderBlMedia() {
      return request.resource.size < 16 * 1024 * 1024
        && (
          request.resource.contentType == null
          || request.resource.contentType == ''
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/jpg'
          || request.resource.contentType == 'image/png'
        );
    }

    function validPurchaseOrderPiMedia() {
      return request.resource.size < 16 * 1024 * 1024
        && (
          request.resource.contentType == null
          || request.resource.contentType == ''
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
          || request.resource.contentType == 'application/excel'
          || request.resource.contentType == 'application/x-excel'
          || request.resource.contentType == 'application/x-msexcel'
        );
    }

    function validPurchaseOrderQcMedia() {
      return request.resource.size < 12 * 1024 * 1024
        && (
          request.resource.contentType == null
          || request.resource.contentType == ''
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType.matches('image/.*')
        );
    }

    function isStaff() {
      return signedIn() && userExists() && role() == 'staff';
    }

    function isOpsUser() {
      return isSuperAdmin() || isStaff();
    }

    function isDealer() {
      return signedIn() && userExists() && (role() == 'dealer' || role() == 'director');
    }

    function isActivePortalUser() {
      return signedIn() && userExists() && (
        isSuperAdmin()
        || userDoc().active != false
      );
    }

    function userDealerId(data) {
      return data.dealerId != null ? data.dealerId : data.directorId;
    }

    function isDealerTeamAdmin() {
      return signedIn()
        && userExists()
        && (role() == 'dealer_staff' || role() == 'director_staff')
        && (
          userDoc().get('staffDepartment', '') == 'admin'
          || (
            userDoc().get('dealerTeams', []) is list
            && 'admin' in userDoc().get('dealerTeams', [])
          )
        )
        && userDealerId(userDoc()) is string
        && userDealerId(userDoc()).size() > 0;
    }

    function resolvedDealerIdForUser() {
      let data = userDoc();
      return role() == 'dealer' || role() == 'director'
        ? request.auth.uid
        : (role() == 'dealer_staff' || role() == 'director_staff'
          ? (userDealerId(data) != null ? userDealerId(data) : request.auth.uid)
          : null);
    }

    function canAccessSupportRequest(requestId) {
      let path = /databases/(default)/documents/dealerSupportRequests/$(requestId);
      let req = firestore.get(path).data;
      return firestore.exists(path)
        && isActivePortalUser()
        && (
          isOpsUser()
          || req.dealerId == resolvedDealerIdForUser()
          || req.createdByUid == request.auth.uid
        );
    }

    function validSupportMedia() {
      return request.resource.size < 52 * 1024 * 1024
        && (
          request.resource.contentType == null
          || request.resource.contentType == ''
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    function staffHasPermission(perm) {
      return isStaff()
        && userDoc().staffPermissions is list
        && perm in userDoc().staffPermissions;
    }

    function staffUsesExplicitPermissions() {
      let u = userDoc();
      return (u.staffAccessMode == 'custom' || u.staffAccessMode == 'role')
        && u.staffPermissions is list
        && u.staffPermissions.size() > 0;
    }

    function staffDepartmentGrantsHrManage() {
      return userDoc().staffDepartment == 'admin';
    }

    function staffDepartmentGrantsHrView() {
      return userDoc().staffDepartment == 'admin';
    }

    function staffHasHrManage() {
      return isStaff() && (
        (staffUsesExplicitPermissions() && staffHasPermission('hr.manage'))
        || (!staffUsesExplicitPermissions() && staffDepartmentGrantsHrManage())
      );
    }

    function staffHasHrView() {
      return isStaff() && (
        staffHasHrManage()
        || (staffUsesExplicitPermissions() && staffHasPermission('hr.view'))
        || (!staffUsesExplicitPermissions() && staffDepartmentGrantsHrView())
      );
    }

    function validHrMedia() {
      return request.resource.size < 16 * 1024 * 1024
        && (
          request.resource.contentType == null
          || request.resource.contentType == ''
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    match /catalog/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /catalogNc/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isOpsUser() && validSupportMedia();
      allow delete: if isOpsUser();
    }

    match /catalogMedia/{productId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /catalogSupport/{productId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Written only via Admin SDK (uploadApprovalNumberPdfFn / removeApprovalNumberPdfFn).
    match /productSettings/approvalPdfs/{fileName} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /invoices/{allPaths=**} {
      allow read, write: if false;
    }

    match /purchaseorders/{allPaths=**} {
      allow read, write: if false;
    }

    // Client-uploaded bill of lading (PDF / JPG) linked to a purchase order.
    match /purchaseOrderBl/{poId}/{fileName} {
      allow read: if isSuperAdmin();
      allow create, update: if isFullSuperAdmin() && validPurchaseOrderBlMedia();
      allow delete: if isFullSuperAdmin();
    }

    // Client-uploaded vendor proforma invoice (PDF / Excel) linked to a purchase order.
    match /purchaseOrderPi/{poId}/{fileName} {
      allow read: if isSuperAdmin();
      allow create, update: if isFullSuperAdmin() && validPurchaseOrderPiMedia();
      allow delete: if isFullSuperAdmin();
    }

    // Client-uploaded QC photos (multi-image) linked to a purchase order.
    match /purchaseOrderQc/{poId}/{fileName} {
      allow read: if isSuperAdmin();
      allow create, update: if isFullSuperAdmin() && validPurchaseOrderQcMedia();
      allow delete: if isFullSuperAdmin();
    }

    match /purchaseOrderTracking/{poId}/{fileName} {
      allow read: if isSuperAdmin();
      allow create, update: if isFullSuperAdmin() && validPurchaseOrderQcMedia();
      allow delete: if isFullSuperAdmin();
    }

    match /salesorders/{allPaths=**} {
      allow read, write: if false;
    }

    match /support/{requestId}/{messageId}/{fileName} {
      allow read: if canAccessSupportRequest(requestId);
      allow write: if canAccessSupportRequest(requestId) && validSupportMedia();
    }

    match /hr/{userId}/{allPaths=**} {
      allow read: if signedIn() && userExists() && (
        isSuperAdmin()
        || (userDoc().active != false && (
          request.auth.uid == userId
          || staffHasHrView()
        ))
      );
      allow write: if signedIn() && userExists() && validHrMedia() && (
        isSuperAdmin()
        || (userDoc().active != false && staffHasHrManage())
      );
    }

    /** Dealer-uploaded photos for their Sales / Service staff. */
    match /dealerStaff/{dealerId}/{staffUid}/{fileName} {
      allow read: if isActivePortalUser() && (
        isOpsUser()
        || request.auth.uid == staffUid
        || (isDealer() && dealerId == request.auth.uid)
        || (
          (role() == 'dealer_staff' || role() == 'director_staff')
          && userDealerId(userDoc()) == dealerId
        )
      );
      allow create, update: if isActivePortalUser()
        && validHrMedia()
        && (
          isOpsUser()
          || (isDealer() && dealerId == request.auth.uid)
          || (isDealerTeamAdmin() && userDealerId(userDoc()) == dealerId)
        );
      allow delete: if isOpsUser()
        || (isDealer() && dealerId == request.auth.uid)
        || (isDealerTeamAdmin() && userDealerId(userDoc()) == dealerId);
    }

    function validYesStoreImage() {
      return request.resource != null
        && request.resource.size < 12 * 1024 * 1024
        && (
          request.resource.contentType == null
          || request.resource.contentType == ''
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/octet-stream'
        );
    }

    function isWarehouse() {
      return signedIn() && userExists() && role() == 'warehouse';
    }

    /** Head Office store room photos (rack / row / bin). Ops receive spare parts here. */
    function canReadYesStoreMedia() {
      return signedIn() && userExists() && userDoc().active != false && (
        isWarehouse() || isOpsUser()
      );
    }

    function canWriteYesStoreMedia() {
      return signedIn() && userExists() && userDoc().active != false && (
        isWarehouse() || isFullSuperAdmin() || isStaff()
      );
    }

    match /yesStore/{level}/{parentId}/{fileName} {
      allow read: if canReadYesStoreMedia();
      allow create, update: if canWriteYesStoreMedia() && validYesStoreImage();
      allow delete: if canWriteYesStoreMedia();
    }

    function canAccessLogisticsBooking(bookingId) {
      let path = /databases/(default)/documents/logisticsBookings/$(bookingId);
      return firestore.exists(path)
        && isActivePortalUser()
        && (
          isOpsUser()
          || firestore.get(path).data.dealerId == resolvedDealerIdForUser()
          || (userDoc().keys().hasAny(['zohoCustomerId'])
              && firestore.get(path).data.zohoCustomerId == userDoc().zohoCustomerId)
        );
    }

    function canWriteLogisticsPhoto(bookingId) {
      return validSupportMedia() && (
        isOpsUser()
        // After the booking stub exists, ops/dealer access also unlocks uploads.
        || canAccessLogisticsBooking(bookingId)
      );
    }

    // Nested paths used by the client: logistics/{bookingId}/{slot}/{fileName}
    match /logistics/{bookingId}/{slot}/{fileName} {
      allow read: if isOpsUser() || canAccessLogisticsBooking(bookingId);
      allow create, update: if canWriteLogisticsPhoto(bookingId);
      allow delete: if isOpsUser();
    }

    // Legacy portal payment screenshots — uploads removed; ops may delete leftovers.
    match /dealer-orders/{orderId}/{fileName} {
      allow read, create, update: if false;
      allow delete: if isOpsUser();
    }

    // YesOne SO payment proofs — uploaded via Admin SDK callable only.
    match /sales-order-payments/{salesOrderId}/{fileName} {
      allow read, create, update: if false;
      allow delete: if isOpsUser();
    }

    // Flat legacy paths: logistics/{bookingId}/{fileName}
    match /logistics/{bookingId}/{fileName} {
      allow read: if isOpsUser() || canAccessLogisticsBooking(bookingId);
      allow create, update: if canWriteLogisticsPhoto(bookingId);
      allow delete: if isOpsUser();
    }

    /** Temporary product share cards — public read so WhatsApp can fetch the image. */
    match /whatsappShares/{userId}/{fileName} {
      allow read: if true;
      // Signed-in owner only — avoid Firestore lookups that can fail closed as 403.
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 4 * 1024 * 1024
        && (
          request.resource.contentType == null
          || request.resource.contentType == ''
          || request.resource.contentType.matches('image/.*')
        );
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
