rules_version = '2';
// CI smoke-test marker — 2026-08-27

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().role;
    }

    function isSuperAdmin() {
      return signedIn() && userExists() && (role() == 'super_admin' || role() == 'admin');
    }

    // Missing superAdminAccess → full (legacy accounts).
    // Use .get() — bare field access fails the rule when the key is absent.
    function isFullSuperAdmin() {
      return isSuperAdmin() && userDoc().get('superAdminAccess', 'full') != 'view_only';
    }

    function isStaff() {
      return signedIn() && userExists() && role() == 'staff';
    }

    /** Inbox: staff and full-access admins. View-only admins are excluded. */
    function canUseWhatsApp() {
      return isStaff() || isFullSuperAdmin();
    }

    function isWarehouse() {
      return signedIn() && userExists() && role() == 'warehouse';
    }

    function isMedia() {
      return signedIn() && userExists() && role() == 'media';
    }

    function isOpsUser() {
      return isSuperAdmin() || isStaff();
    }

    function canWriteCatalogMedia() {
      return isFullSuperAdmin() || isMedia();
    }

    function canAccessYesStore() {
      return isWarehouse() || isOpsUser();
    }

    function canWriteYesStore() {
      return isWarehouse() || isFullSuperAdmin() || isStaff();
    }

    function isDealer() {
      return signedIn() && (role() == 'dealer' || role() == 'director');
    }

    function dealerOwnsZohoCustomer(customerId) {
      return signedIn()
        && userExists()
        && (role() == 'dealer' || role() == 'director'
          || role() == 'dealer_staff' || role() == 'director_staff')
        && customerId is string
        && customerId.size() > 0
        && userDoc().get('zohoCustomerId', '') == customerId;
    }

    function isActiveUser() {
      return signedIn() && userExists() && (
        isSuperAdmin()
        || userDoc().active != false
      );
    }

    function bootstrapOpen() {
      return !exists(/databases/$(database)/documents/appSettings/system)
        || get(/databases/$(database)/documents/appSettings/system).data.bootstrapComplete != true;
    }

    function staffCanManageRole(targetRole) {
      return targetRole == 'dealer' || targetRole == 'dealer_staff'
        || targetRole == 'director' || targetRole == 'director_staff';
    }

    function userDealerId(data) {
      return data.dealerId != null ? data.dealerId : data.directorId;
    }

    function isDealerStaffRole(r) {
      return r == 'dealer_staff' || r == 'director_staff';
    }

    // Dealer-portal Admin staff may manage that dealer's team. Sales and Service cannot.
    function isDealerTeamAdmin() {
      return signedIn()
        && userExists()
        && isDealerStaffRole(role())
        && (
          userDoc().get('staffDepartment', '') == 'admin'
          || (
            userDoc().get('dealerTeams', []) is list
            && 'admin' in userDoc().get('dealerTeams', [])
          )
        )
        && userDealerId(userDoc()) is string
        && userDealerId(userDoc()).size() > 0;
    }

    function managesDealerAccount(accountId) {
      return accountId is string
        && accountId.size() > 0
        && (
          (isDealer() && request.auth.uid == accountId)
          || (isDealerTeamAdmin() && userDealerId(userDoc()) == accountId)
        );
    }

    function validLoginIdType(t) {
      return t == 'aadhar' || t == 'phone' || t == 'email' || t == 'username';
    }

    function validLoginId(data) {
      return data.loginId is string
        && data.loginIdType is string
        && validLoginIdType(data.loginIdType)
        && (
          (data.loginIdType == 'aadhar' && data.loginId.size() == 12)
          || (data.loginIdType == 'phone' && data.loginId.size() == 10)
          || (data.loginIdType == 'email' && data.loginId.matches('^[^@]+@[^@]+\\.[^@]+$'))
          || (data.loginIdType == 'username'
              && data.loginId.size() >= 2
              && data.loginId.size() <= 32
              && data.loginId.matches('^[a-z0-9][a-z0-9.-]*[a-z0-9]$|^[a-z0-9]$'))
        );
    }

    function validAadhar(data) {
      return validLoginId(data) || (data.aadhar is string && data.aadhar.size() == 12);
    }

    function loginIdUnchanged() {
      return !resource.data.keys().hasAny(['loginId'])
        || (request.resource.data.loginId == resource.data.loginId
            && request.resource.data.loginIdType == resource.data.loginIdType);
    }

    function validStaffDepartment(d) {
      return d == 'sales' || d == 'service' || d == 'logistics' || d == 'admin';
    }

    function validStaffAccessMode(m) {
      return m == 'department' || m == 'custom' || m == 'role';
    }

    function validStaffLogisticsSite(site) {
      return site == null || site == 'cochin' || site == 'head_office';
    }

    function validStaffAccessFields(data) {
      return (!('staffDepartment' in data) || validStaffDepartment(data.staffDepartment))
        && (!('staffAccessMode' in data) || validStaffAccessMode(data.staffAccessMode))
        && (!('staffPermissions' in data) || data.staffPermissions is list)
        && (!('staffTeamId' in data) || data.staffTeamId == null || data.staffTeamId is string)
        && (!('staffRoleId' in data) || data.staffRoleId == null || data.staffRoleId is string)
        && (!('staffLogisticsSite' in data) || validStaffLogisticsSite(data.staffLogisticsSite));
    }

    function validDealerTier(t) {
      return t == 'standard' || t == 'director';
    }

    function validDealerAccessMode(m) {
      return m == 'tier' || m == 'custom';
    }

    function validDealerTeams(teams) {
      return teams == null
        || (teams is list && teams.size() == 1 && teams[0] == 'admin')
        || (teams is list
            && teams.size() <= 2
            && (teams.size() == 0 || teams[0] == 'sales' || teams[0] == 'service')
            && (teams.size() < 2 || teams[1] == 'sales' || teams[1] == 'service'));
    }

    function validDealerAccessFields(data) {
      return (!('dealerTier' in data) || validDealerTier(data.dealerTier))
        && (!('dealerAccessMode' in data) || validDealerAccessMode(data.dealerAccessMode))
        && (!('dealerPermissions' in data) || data.dealerPermissions is list)
        && (!('dealerTeams' in data) || validDealerTeams(data.dealerTeams));
    }

    function validDealerStaffPhotoFields(data) {
      return (!('hrPhotoStoragePath' in data)
          || data.hrPhotoStoragePath == null
          || data.hrPhotoStoragePath is string)
        && (!('hrPhotoUrl' in data)
          || data.hrPhotoUrl == null
          || data.hrPhotoUrl is string)
        && (!('hrBloodGroup' in data)
          || data.hrBloodGroup == null
          || data.hrBloodGroup is string)
        && (!('hrDateOfBirth' in data)
          || data.hrDateOfBirth == null
          || data.hrDateOfBirth is string)
        && (!('hrEmployeeId' in data)
          || data.hrEmployeeId == null
          || data.hrEmployeeId is string);
    }

    function validDealerPortalUserWrite(data) {
      return (data.role != 'dealer' && data.role != 'dealer_staff' && data.role != 'director' && data.role != 'director_staff')
        || (validDealerAccessFields(data) && validDealerStaffPhotoFields(data));
    }

    function validStaffUserWrite(data) {
      return data.role == 'staff' ? validStaffAccessFields(data) : true;
    }

    function validManagedUserWrite(data) {
      return validStaffUserWrite(data) && validDealerPortalUserWrite(data);
    }

    function validAadharId(aadhar) {
      return aadhar is string && aadhar.size() == 12;
    }

    function staffHasPermission(perm) {
      let roleId = userDoc().get('staffRoleId', '');
      let mode = userDoc().get('staffAccessMode', 'role');
      return isStaff() && (
        (mode != 'custom' && roleId == 'role-admin')
        || (mode != 'custom' && roleId == 'role-hr-manager' && (
          perm == 'hr.view' || perm == 'hr.manage' || perm == 'staff.manage'
          || perm == 'dealers.view' || perm == 'dealers.edit' || perm == 'tasks.view'
          || perm == 'catalog.view' || perm == 'invoices.view'
        ))
        || (userDoc().staffPermissions is list && perm in userDoc().staffPermissions)
      );
    }

    function staffUsesExplicitPermissions() {
      let u = userDoc();
      return (u.staffAccessMode == 'custom' || u.staffAccessMode == 'role')
        && u.staffPermissions is list
        && u.staffPermissions.size() > 0;
    }

    function staffDepartmentGrantsHrManage() {
      return userDoc().staffDepartment == 'admin';
    }

    function staffDepartmentGrantsHrView() {
      return userDoc().staffDepartment == 'admin';
    }

    function staffHasHrManage() {
      return isStaff() && (
        (staffUsesExplicitPermissions() && staffHasPermission('hr.manage'))
        || (!staffUsesExplicitPermissions() && staffDepartmentGrantsHrManage())
      );
    }

    function staffHasHrView() {
      return isStaff() && (
        staffHasHrManage()
        || (staffUsesExplicitPermissions() && staffHasPermission('hr.view'))
        || (!staffUsesExplicitPermissions() && staffDepartmentGrantsHrView())
      );
    }

    // Sales + admin departments see dealers by default; custom/role modes use permissions.
    function staffDepartmentGrantsDealersView() {
      return userDoc().staffDepartment == 'sales'
        || userDoc().staffDepartment == 'admin';
    }

    function staffHasDealersView() {
      return isStaff() && (
        (staffUsesExplicitPermissions() && (
          staffHasPermission('dealers.view') || staffHasPermission('dealers.edit')
        ))
        || (!staffUsesExplicitPermissions() && staffDepartmentGrantsDealersView())
      );
    }

    match /appSettings/{docId} {
      // Courier API passwords / license keys + cached JWTs are Admin SDK only.
      allow read: if signedIn()
        && docId != 'delhiveryB2bSecrets'
        && docId != 'delhiveryB2bAuth'
        && docId != 'blueDartSecrets'
        && docId != 'blueDartAuth'
        && (docId != 'yesgatcWebhook' || isFullSuperAdmin());
      allow write: if signedIn()
        && docId != 'delhiveryB2bSecrets'
        && docId != 'delhiveryB2bAuth'
        && docId != 'blueDartSecrets'
        && docId != 'blueDartAuth'
        && (
        bootstrapOpen()
        || (docId == 'productSettings' && isFullSuperAdmin())
        || (docId == 'serialNumberAllotment' && isFullSuperAdmin())
        || (docId == 'logisticsSettings' && isFullSuperAdmin())
        || (docId == 'logisticsCourierRates' && isFullSuperAdmin())
        || (docId == 'priceLevels' && (isFullSuperAdmin() || staffHasDealersView()))
        || (docId == 'sparePricing' && isFullSuperAdmin())
        || (docId == 'localPrinterSettings' && isFullSuperAdmin())
        || (docId == 'labelStudio' && isFullSuperAdmin())
        || (docId == 'spareIncharge' && (isFullSuperAdmin() || staffHasHrManage()))
        || (docId == 'yesgatcWebhook' && isFullSuperAdmin())
      );
    }

    // Blue Dart pin serviceability index (seeded from BdService workbook).
    match /nonGatcSerialAllocations/{serialKey} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /serialUnits/{serialKey} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /productSerialCursors/{productId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /blueDartPincodes/{pincode} {
      allow read: if signedIn();
      allow write: if isFullSuperAdmin();
    }

    match /catalogProducts/{productId} {
      allow read: if true;
      allow write: if false;
      allow update: if (isFullSuperAdmin() || isStaff())
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['pas', 'pasModelId', 'syncedAt']);

      match /auditLogs/{logId} {
        allow read: if isOpsUser() || isWarehouse();
        allow write: if false;
      }
    }

    match /catalogCategories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    match /catalogMeta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /zohoMeta/{docId} {
      allow read: if isOpsUser() && docId == 'apiUsage';
      allow write: if false;
    }

    match /zohoWebhookRetries/{retryId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /catalogProductSpareMap/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /zohoCustomers/{customerId} {
      allow read: if isOpsUser() || dealerOwnsZohoCustomer(customerId);
      allow write: if false;

      match /invoices/{invoiceId} {
        allow read: if isOpsUser() || dealerOwnsZohoCustomer(customerId);
        allow write: if false;
      }

      match /invoiceSummaries/{invoiceId} {
        allow read: if isOpsUser();
        allow write: if false;
      }

      match /invoicesArchive/{invoiceId} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }

      match /invoiceSummariesArchive/{invoiceId} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }

      match /invoiceMeta/{docId} {
        allow read, write: if false;
      }

      match /invoiceSearch/{invoiceId} {
        allow read, write: if false;
      }
    }

    // Required for admin collectionGroup(db, 'invoices') live queries.
    match /{path=**}/invoices/{invoiceId} {
      allow read: if isOpsUser()
        || (resource.data.customerId is string
            && dealerOwnsZohoCustomer(resource.data.customerId));
      allow write: if false;
    }

    match /{path=**}/invoiceSummaries/{invoiceId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /invoiceIndex/{invoiceId} {
      allow read, write: if false;
    }

    match /invoiceMeta/{docId} {
      allow read, write: if false;
    }

    match /invoiceStats/{docId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /invoiceMonthStats/{monthId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /invoiceDealerStats/{customerId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /salesOrderStats/{docId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /salesOrderMonthStats/{monthId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /salesOrderDealerStats/{customerId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    function staffHasInvoiceView() {
      let roleId = userDoc().get('staffRoleId', '');
      return isStaff() && (
        roleId == 'role-invoice-access'
        || roleId == 'role-sales'
        || roleId == 'role-admin'
        || roleId == 'role-logistics'
        || roleId == 'role-hr-manager'
        || staffHasPermission('invoices.view')
        || (!staffUsesExplicitPermissions()
            && (userDoc().staffDepartment == 'sales'
                || userDoc().staffDepartment == 'admin'
                || userDoc().staffDepartment == 'logistics'))
      );
    }

    function canReadShipmentTracking() {
      return isOpsUser()
        || isWarehouse()
        || isMedia()
        || (
          signedIn()
          && userExists()
          && (role() == 'dealer' || role() == 'director'
            || role() == 'dealer_staff' || role() == 'director_staff')
          && userDoc().get('zohoCustomerId', '') is string
          && userDoc().get('zohoCustomerId', '').size() > 0
          && exists(/databases/$(database)/documents/appSettings/priceLevels)
          && userDoc().get('zohoCustomerId', '')
            in get(/databases/$(database)/documents/appSettings/priceLevels)
              .data.get('directorsDealerIds', [])
        );
    }

    // Org-wide Zoho purchase orders — staff and super admin may read
    // (catalog on-order qty + spare indent last-purchase). Zoho writes via functions.
    // Directors price-level dealers may read for catalog ship tracking.
    // Full super admin may attach a vendor PI and bill of lading only.
    match /purchaseOrders/{poId} {
      allow read: if canReadShipmentTracking();
      allow create, delete: if false;
      allow update: if isFullSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'blContainerNumber',
              'blShippingLine',
              'blNumber',
              'blVesselName',
              'blDate',
              'blPortOfLoading',
              'blPortOfDischarge',
              'blStoragePath',
              'blFileName',
              'blContentType',
              'blUploadedAt',
              'blUploadedBy',
              'blLinkedFromPurchaseOrderId',
              'blLinkedFromPurchaseOrderNumber',
              'wanHaiTrack',
              'qcImages',
              'trackingScreenshots',
              'piStoragePath',
              'piFileName',
              'piContentType',
              'piUploadedAt',
              'piUploadedBy',
              'piTotalAmount',
              'piCurrencyCode',
              'piDate',
              'kotakPayout',
              'tracking',
              'activityLogs',
              'serialRangesByLineId',
              'serialRangesUpdatedAt',
            ]);
    }

    // Draft Zoho purchase bills mirrored as goods receipts.
    // Same readers as purchase orders (catalog ship qty after receive).
    // Invoice-access staff (and sales/admin dept) may update receive-check only.
    match /goodsReceipts/{billId} {
      allow read: if canReadShipmentTracking();
      allow create, delete: if false;
      allow update: if (isFullSuperAdmin() || staffHasInvoiceView())
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['receiveCheck']);
    }

    // Manual spare purchase-cost overrides (Spare pricing tab). Defaults come from PO lines.
    match /sparePurchaseCosts/{productId} {
      allow read: if isSuperAdmin();
      allow write: if isFullSuperAdmin();
    }

    match /spareIndents/{indentId} {
      allow read: if isOpsUser();
      allow create: if (isStaff() || isFullSuperAdmin())
        && request.resource.data.catalogProductId is string
        && request.resource.data.catalogProductId.size() > 0
        && request.resource.data.qty is number
        && request.resource.data.qty >= 1
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt is string;
      allow update: if isFullSuperAdmin()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid;
      allow delete: if isFullSuperAdmin();
    }

    match /zohoVendors/{vendorId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /zohoVendorMeta/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /purchaseOrderMeta/{docId} {
      allow read, write: if false;
    }

    match /goodsReceiptMeta/{docId} {
      allow read, write: if false;
    }

    // Org-wide Zoho sales orders (customer-scoped fields on each doc).
    // All ops staff may read — client still scopes org-wide lists by salesperson.
    match /salesOrders/{soId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /salesOrderMeta/{docId} {
      allow read, write: if false;
    }

    // Kotak uncategorised bank feeds mirrored from Zoho Banking.
    match /kotakBankFeeds/{feedId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /kotakBankFeedMeta/{docId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    // Portal invoice GATC stamping ledger (written by Cloud Functions on payment verify).
    // Incentive report also reads ops invoice summaries, invoice docs, salesOrders,
    // and appSettings/priceLevels (Directors 2% vs 3.5%).
    match /gatcReports/{invoiceId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /yesgatcCertificates/{certificateId} {
      allow get, list: if isOpsUser() || isWarehouse();
      allow write: if false;
    }

    match /yesgatcSerialLinks/{serialId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /yesgatcRcDetails/{rcId} {
      allow get, list: if isOpsUser();
      allow write: if false;
    }

    match /yesgatcRcDealerLinks/{rcId} {
      allow read: if isOpsUser();
      allow write: if isFullSuperAdmin() || staffHasPermission('yesgatc.rc_link');
    }

    // Official dealer RC roster (code + name + place). Stats stay computed.
    match /yesgatcRcOffices/{rcCode} {
      allow get, list: if isOpsUser() || isWarehouse();
      allow write: if isFullSuperAdmin();
    }

    // Super-admin line exclusions on the incentive report (hike / discount lines).
    match /incentiveLineExclusions/{exclusionId} {
      allow read: if isOpsUser();
      allow create, update, delete: if isFullSuperAdmin();
    }

    // Incentive-only applicable-rate appends. Staff/admin; does not change Zoho invoices.
    match /incentiveLineRateOverrides/{overrideId} {
      allow read: if isOpsUser();
      allow create, update, delete: if isFullSuperAdmin() || isStaff();
    }

    // Monthly sales target per KAM. Incentive = max(0, rate-card sales − target) × 3.5%.
    match /incentiveTargets/{targetId} {
      allow read: if isOpsUser();
      allow create, update, delete: if isFullSuperAdmin();
    }

    // Recalculated incentive (3.5% / 2% on rate-card sales, not invoice value).
    match /incentiveSnapshots/{invoiceId} {
      allow read: if isOpsUser();
      allow create, update, delete: if isOpsUser();
    }

    // Zoho salesperson cache — ops need this for create-SO (Cloud Charges, pickers).
    match /zohoSalespersons/{salespersonId} {
      allow read: if isActiveUser() && (isOpsUser() || staffHasHrView());
      allow write: if false;
    }

    match /zohoSalespersonMeta/{docId} {
      allow read: if isActiveUser() && (isOpsUser() || staffHasHrView());
      allow write: if false;
    }

    match /staffRoles/{roleId} {
      allow read: if isActiveUser() && (isSuperAdmin() || staffHasHrView());
      allow create, update, delete: if isFullSuperAdmin();
    }

    match /hrHolidays/{holidayId} {
      allow read: if isActiveUser() && (isSuperAdmin() || staffHasHrView());
      allow create, update, delete: if isFullSuperAdmin() || staffHasHrManage();
    }

    match /hrSalaryMonths/{docId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if isFullSuperAdmin();
    }

    match /hrPayrollEmployees/{employeeId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if isFullSuperAdmin();
    }

    // Public salary month snapshots (unguessable token as doc id).
    match /hrSalaryShares/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isFullSuperAdmin();
      allow delete: if isFullSuperAdmin();
    }

    match /dealerSettings/{docId} {
      allow read: if isOpsUser();
      allow write: if false;
    }

    match /aadharIndex/{aadhar} {
      allow read: if isActiveUser() && (isOpsUser() || isDealer());
      allow create: if validAadharId(aadhar)
        && isActiveUser()
        && (isOpsUser() || isDealer())
        && request.resource.data.uid is string
        && request.resource.data.role is string;
      allow delete: if isFullSuperAdmin();
    }

    match /dealer_otp_sessions/{phone} {
      allow read, write: if false;
    }

    match /loginIndex/{loginKey} {
      allow read: if isActiveUser() && (isOpsUser() || isDealer() || isDealerTeamAdmin());
      allow create: if isActiveUser()
        && (isOpsUser() || isDealer() || isDealerTeamAdmin())
        && request.resource.data.uid is string
        && request.resource.data.role is string
        && request.resource.data.loginIdType is string
        && validLoginIdType(request.resource.data.loginIdType);
      allow delete: if isFullSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isActiveUser() && (
        isOpsUser()
        || request.auth.uid == userId
        || (isDealer() && userDealerId(resource.data) == request.auth.uid)
        || (isDealerStaffRole(role()) && userDealerId(resource.data) == userDealerId(userDoc()))
      );

      allow create: if signedIn() && (
        (bootstrapOpen()
          && request.auth.uid == userId
          && (request.resource.data.role == 'super_admin' || request.resource.data.role == 'admin')
          && request.resource.data.active == true
          && validAadhar(request.resource.data))
        || (isActiveUser() && isFullSuperAdmin() && validAadhar(request.resource.data) && validManagedUserWrite(request.resource.data))
        || (isActiveUser()
            && staffHasHrManage()
            && request.resource.data.role == 'staff'
            && request.resource.data.active == true
            && validAadhar(request.resource.data)
            && validStaffUserWrite(request.resource.data))
        || (isActiveUser()
            && staffHasHrManage()
            && request.resource.data.role == 'warehouse'
            && request.resource.data.active == true
            && validAadhar(request.resource.data))
        || (isActiveUser()
            && staffHasHrManage()
            && request.resource.data.role == 'media'
            && request.resource.data.active == true
            && validAadhar(request.resource.data))
        || (isActiveUser()
            && isStaff()
            && staffCanManageRole(request.resource.data.role)
            && request.resource.data.active == true
            && validAadhar(request.resource.data)
            && validDealerPortalUserWrite(request.resource.data))
        || (managesDealerAccount(userDealerId(request.resource.data))
            && isDealerStaffRole(request.resource.data.role)
            && request.resource.data.active == true
            && validAadhar(request.resource.data)
            && validDealerPortalUserWrite(request.resource.data))
      );

      allow update: if isActiveUser() && (
        (isFullSuperAdmin() && validManagedUserWrite(request.resource.data))
        || (staffHasHrManage()
            && resource.data.role == 'staff'
            && request.resource.data.role == 'staff'
            && loginIdUnchanged()
            && validStaffUserWrite(request.resource.data))
        || (staffHasHrManage()
            && resource.data.role == 'warehouse'
            && request.resource.data.role == 'warehouse'
            && loginIdUnchanged())
        || (staffHasHrManage()
            && resource.data.role == 'media'
            && request.resource.data.role == 'media'
            && loginIdUnchanged())
        || (isStaff()
            && staffCanManageRole(resource.data.role)
            && staffCanManageRole(request.resource.data.role)
            && resource.data.role == request.resource.data.role
            && loginIdUnchanged()
            && validDealerPortalUserWrite(request.resource.data))
        || (request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'loginId', 'loginIdType', 'aadhar', 'email', 'dealerId', 'directorId', 'active', 'createdAt', 'createdByUid', 'superAdminAccess']))
        || (managesDealerAccount(userDealerId(resource.data))
            && isDealerStaffRole(resource.data.role)
            && managesDealerAccount(userDealerId(request.resource.data))
            && isDealerStaffRole(request.resource.data.role)
            && validDealerPortalUserWrite(request.resource.data))
      );

      allow delete: if isFullSuperAdmin();
    }

    function isDealerStaff() {
      return signedIn() && isDealerStaffRole(role());
    }

    function isSupportDraftData(data) {
      return data.lifecycle == 'draft' || data.status == 'draft';
    }

    function isSupportClosedData(data) {
      return data.lifecycle == 'resolved'
        || data.lifecycle == 'cancelled'
        || data.status == 'completed'
        || data.status == 'cancelled';
    }

    function validDealerSupportChatCreate() {
      let data = request.resource.data;
      return data.type == 'chat'
        && data.lifecycle == 'open'
        && data.openStage == 'submitted'
        && data.requestNumber is string
        && data.requestNumber.size() > 0
        && data.category == 'general'
        && data.description is string
        && data.createdAt is string
        && data.createdByUid == request.auth.uid
        && data.createdByName is string
        && data.dealerId is string
        && (
          (isDealer() && data.dealerId == request.auth.uid)
          || (isDealerStaff() && data.dealerId == userDealerId(userDoc()))
        );
    }

    function validDealerSupportDraftCreate() {
      let data = request.resource.data;
      return data.type is string
        && (data.type == 'service' || data.type == 'return' || data.type == 'complaint' || data.type == 'chat')
        && data.requestNumber is string
        && data.requestNumber.size() > 0
        && isSupportDraftData(data)
        && data.category is string
        && data.description is string
        && data.createdAt is string
        && data.createdByUid == request.auth.uid
        && data.createdByName is string
        && data.dealerId is string
        && (
          (isDealer() && data.dealerId == request.auth.uid)
          || (isDealerStaff() && data.dealerId == userDealerId(userDoc()))
        );
    }

    function validOpsSupportDraftCreate() {
      let data = request.resource.data;
      return isOpsUser()
        && data.type is string
        && (data.type == 'service' || data.type == 'return' || data.type == 'complaint')
        && data.requestNumber is string
        && data.requestNumber.size() > 0
        && isSupportDraftData(data)
        && data.category is string
        && data.description is string
        && data.createdAt is string
        && data.createdByUid == request.auth.uid
        && data.createdByName is string
        && data.dealerId is string
        && data.dealerName is string
        && data.zohoCustomerId is string
        && data.createdOnBehalfOf == true;
    }

    function validOpsSupportDraftUpdate() {
      let data = request.resource.data;
      return isOpsUser()
        && resource.data.createdOnBehalfOf == true
        && isSupportDraftData(resource.data)
        && isSupportDraftData(data)
        && dealerSupportImmutableFieldsMatch()
        && data.type is string
        && (data.type == 'service' || data.type == 'return' || data.type == 'complaint')
        && data.category is string
        && data.description is string
        && data.updatedAt is string
        && data.createdOnBehalfOf == true
        && data.zohoCustomerId is string;
    }

    function dealerSupportImmutableFieldsMatch() {
      let data = request.resource.data;
      let prev = resource.data;
      return data.dealerId == prev.dealerId
        && data.createdByUid == prev.createdByUid
        && data.createdAt == prev.createdAt
        && data.requestNumber == prev.requestNumber;
    }

    function validDealerSupportDraftUpdate() {
      let data = request.resource.data;
      return isSupportDraftData(resource.data)
        && isSupportDraftData(data)
        && dealerSupportImmutableFieldsMatch()
        && data.type is string
        && (data.type == 'service' || data.type == 'return' || data.type == 'complaint' || data.type == 'chat')
        && data.category is string
        && data.description is string
        && data.updatedAt is string;
    }

    function validDealerSupportSubmit() {
      let data = request.resource.data;
      return isSupportDraftData(resource.data)
        && data.lifecycle == 'open'
        && data.openStage == 'submitted'
        && dealerSupportImmutableFieldsMatch()
        && data.type is string
        && (data.type == 'service' || data.type == 'return' || data.type == 'complaint' || data.type == 'chat')
        && data.category is string
        && data.category.size() > 0
        && data.description is string
        && data.description.size() > 0
        && data.updatedAt is string;
    }

    function validDealerSupportMarkShipped() {
      let data = request.resource.data;
      return isSupportRequestDealerAccess(resource.data)
        && resource.data.lifecycle == 'open'
        && resource.data.openStage == 'awaiting_product'
        && data.lifecycle == 'open'
        && data.openStage == 'in_transit'
        && dealerSupportImmutableFieldsMatch()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lifecycle', 'openStage', 'courierTracking', 'shippedAt', 'updatedAt']);
    }

    function validDealerSupportCancel() {
      let data = request.resource.data;
      return isSupportRequestDealerAccess(resource.data)
        && resource.data.lifecycle == 'open'
        && (
          resource.data.openStage == 'submitted'
          || resource.data.openStage == 'under_review'
          || resource.data.openStage == 'awaiting_dealer'
        )
        && data.lifecycle == 'cancelled'
        && data.openStage == null
        && dealerSupportImmutableFieldsMatch()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lifecycle', 'openStage', 'updatedAt']);
    }

    function validDealerSupportMessageMetaUpdate() {
      return isSupportRequestDealerAccess(resource.data)
        && !isSupportClosedData(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['updatedAt', 'lastMessageAt', 'lastMessagePreview', 'openStage']);
    }

    match /dealerSupportRequests/{requestId} {
      allow read: if isActiveUser() && (
        isOpsUser()
        || (isDealer() && resource.data.dealerId == request.auth.uid)
        || (isDealerStaff() && resource.data.dealerId == userDealerId(userDoc()))
        || resource.data.createdByUid == request.auth.uid
      );

      allow create: if isActiveUser()
        && (
          ((isDealer() || isDealerStaff()) && (validDealerSupportDraftCreate() || validDealerSupportChatCreate()))
          || validOpsSupportDraftCreate()
        );

      allow update: if isActiveUser() && (
        isOpsUser()
        || validDealerSupportMessageMetaUpdate()
        || validOpsSupportDraftUpdate()
        || (
          isSupportRequestDealerAccess(resource.data)
          && validDealerSupportDraftUpdate()
        )
        || (
          isSupportRequestDealerAccess(resource.data)
          && validDealerSupportSubmit()
        )
        || validDealerSupportMarkShipped()
        || validDealerSupportCancel()
      );

      allow delete: if isFullSuperAdmin()
        || (
          isActiveUser()
          && isSupportRequestDealerAccess(resource.data)
          && isSupportDraftData(resource.data)
        );

      match /messages/{messageId} {
        allow read: if isActiveUser() && canReadSupportRequest(requestId);

        allow create: if isActiveUser()
          && canReadSupportRequest(requestId)
          && canWriteSupportMessage(requestId)
          && validSupportMessageCreate();

        allow update: if false;
        allow delete: if isFullSuperAdmin();
      }
    }

    function canReadSupportRequest(requestId) {
      let req = get(/databases/$(database)/documents/dealerSupportRequests/$(requestId)).data;
      return isOpsUser()
        || (isDealer() && req.dealerId == request.auth.uid)
        || (isDealerStaff() && req.dealerId == userDealerId(userDoc()))
        || req.createdByUid == request.auth.uid;
    }

    function isSupportRequestDealerAccess(data) {
      return (isDealer() && data.dealerId == request.auth.uid)
        || (isDealerStaff() && data.dealerId == userDealerId(userDoc()))
        || data.createdByUid == request.auth.uid;
    }

    function canWriteSupportMessage(requestId) {
      let req = get(/databases/$(database)/documents/dealerSupportRequests/$(requestId)).data;
      let msg = request.resource.data;
      return isOpsUser()
        || (req.lifecycle == 'open' && !isSupportClosedData(req))
        || (isSupportDraftData(req) && msg.isInitial == true && msg.authorUid == request.auth.uid);
    }

    function validSupportMessageCreate() {
      let data = request.resource.data;
      return data.authorUid == request.auth.uid
        && data.authorName is string
        && data.authorRole is string
        && data.createdAt is string
        && data.text is string
        && data.attachments is list;
    }

    // Head Office store room (spares): rack / row / bin.
    match /yesStoreRacks/{rackId} {
      allow read: if canAccessYesStore();
      allow write: if canWriteYesStore();
    }

    match /yesStoreRows/{rowId} {
      allow read: if canAccessYesStore();
      allow write: if canWriteYesStore();
    }

    match /yesStoreBins/{binId} {
      allow read: if canAccessYesStore();
      allow write: if canWriteYesStore();
    }

    match /yesStoreItems/{itemId} {
      allow read: if canAccessYesStore();
      allow write: if canWriteYesStore();
    }

    // Cochin warehouse (shop products): zone / row.
    match /warehouseZones/{zoneId} {
      allow read: if isOpsUser() || isWarehouse();
      allow write: if isFullSuperAdmin();
    }

    match /warehouseZoneRows/{rowId} {
      allow read: if isOpsUser() || isWarehouse();
      allow write: if isFullSuperAdmin();
    }

    match /catalogSiteInventory/{docId} {
      allow read: if isOpsUser() || isWarehouse();
      allow write: if isFullSuperAdmin() || isStaff();
    }

    match /auditCycles/{cycleId} {
      allow read: if isOpsUser() || isWarehouse();
      allow write: if isFullSuperAdmin();
    }

    match /catalogProductNc/{productId} {
      allow read: if isOpsUser();
      allow write: if isFullSuperAdmin() || isStaff();
    }

    match /catalogProductMedia/{productId} {
      allow read: if true;
      allow write: if isActiveUser() && canWriteCatalogMedia();
    }

    match /catalogProductSupport/{productId} {
      allow read: if true;
      allow write: if isActiveUser() && canWriteCatalogMedia();
    }

    function isLogisticsBookingDealerAccess(data) {
      return (isDealer() && (
          data.dealerId == request.auth.uid
          || (userDoc().keys().hasAny(['zohoCustomerId'])
              && data.zohoCustomerId == userDoc().zohoCustomerId)
        ))
        || (isDealerStaff() && (
          data.dealerId == userDealerId(userDoc())
          || (userDoc().keys().hasAny(['zohoCustomerId'])
              && data.zohoCustomerId == userDoc().zohoCustomerId)
        ));
    }

    function validLogisticsBookingCreate() {
      let data = request.resource.data;
      return isOpsUser()
        && data.partnerId is string
        && data.consignmentNo is string
        && (
          data.consignmentNo.size() > 0
          || (data.keys().hasAny(['wizardStep']) && data.wizardStep is string && data.wizardStep.size() > 0)
        )
        && data.zohoCustomerId is string
        && data.dealerId is string
        && data.dealerSnapshot is map
        && (
          data.status == 'label_generated'
          || data.status == 'in_transit'
          || data.status == 'delivered'
          || data.status == 'cancelled'
          || data.status == 'returned'
          // Legacy removed stage (normalized to in_transit on read)
          || data.status == 'shipped'
        )
        && data.createdByUid == request.auth.uid
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function canWriteOpsLogistics() {
      return isFullSuperAdmin() || isStaff();
    }

    function validLogisticsBookingOpsUpdate() {
      // Ops may complete/resume bookings started by another staff member.
      // Keep provenance (createdAt / createdByUid) immutable; dealer keys may be
      // re-synced from Zoho when portal linking changes between draft and confirm.
      return canWriteOpsLogistics()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdByUid == resource.data.createdByUid;
    }

    match /logisticsBookings/{bookingId} {
      allow read: if isActiveUser() && (
        isOpsUser()
        || isLogisticsBookingDealerAccess(resource.data)
      );

      allow create: if isActiveUser() && canWriteOpsLogistics() && validLogisticsBookingCreate();

      allow update: if isActiveUser() && canWriteOpsLogistics() && validLogisticsBookingOpsUpdate();

      allow delete: if isFullSuperAdmin();
    }

    /**
     * Per-dealer catalog MRP. Client reads own dealer’s docs;
     * writes go through setDealerCatalogMrpFn (Admin SDK).
     */
    match /dealerCatalogMrp/{dealerId} {
      allow read: if isActiveUser() && (
        isOpsUser()
        || (isDealer() && dealerId == request.auth.uid)
        || (isDealerStaff() && dealerId == userDealerId(userDoc()))
      );
      allow write: if false;

      match /products/{productId} {
        allow read: if isActiveUser() && (
          isOpsUser()
          || (isDealer() && dealerId == request.auth.uid)
          || (isDealerStaff() && dealerId == userDealerId(userDoc()))
        );
        allow write: if false;
      }
    }

    /** Shared dealer cart (owner + sales/service staff). Approvals are Cloud Function only. */
    function ownsDealerCart(dealerUid) {
      return (isDealer() && request.auth.uid == dealerUid)
        || (isDealerStaff() && userDealerId(userDoc()) == dealerUid);
    }

    match /dealerCarts/{dealerUid} {
      allow read: if isActiveUser() && ownsDealerCart(dealerUid);
      allow create, update: if isActiveUser() && ownsDealerCart(dealerUid);
      allow delete: if isActiveUser() && isDealer() && request.auth.uid == dealerUid;

      match /items/{itemId} {
        allow read: if isActiveUser() && ownsDealerCart(dealerUid);
        allow create: if isActiveUser()
          && ownsDealerCart(dealerUid)
          && request.resource.data.productId is string
          && request.resource.data.addedByUid == request.auth.uid;
        allow update: if isActiveUser() && ownsDealerCart(dealerUid) && (
          (isDealer() && request.auth.uid == dealerUid)
          || (
            isDealerStaff()
            && resource.data.addedByUid == request.auth.uid
            && request.resource.data.addedByUid == resource.data.addedByUid
          )
        );
        allow delete: if isActiveUser() && ownsDealerCart(dealerUid) && (
          (isDealer() && request.auth.uid == dealerUid)
          || (isDealerStaff() && resource.data.addedByUid == request.auth.uid)
        );
      }

      match /approvals/{approvalId} {
        allow read: if isActiveUser() && ownsDealerCart(dealerUid);
        allow create, update, delete: if false;
      }
    }

    /** Legacy portal orders — deprecated; purge via purgeDealerOrders callable. */
    match /dealerOrders/{orderId} {
      allow read, create, update, delete: if false;
    }

    match /dealerOrderCounters/{dayId} {
      allow read, write: if false;
    }

    match /whatsappConversations/{chatId} {
      allow read: if canUseWhatsApp();
      allow update: if canUseWhatsApp()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCount']);
      allow create, delete: if false;
    }

    match /whatsappMessages/{messageId} {
      allow read: if canUseWhatsApp();
      allow write: if false;
    }

    match /whatsappSettings/{docId} {
      allow read, write: if false;
    }

    /** Voxbay / staff call log. Webhook writes; staff only mark missed follow-up. */
    match /phoneEvents/{eventId} {
      allow read: if isSuperAdmin();
      allow update: if isFullSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['missedFollowedUp', 'missedFollowedUpBy', 'missedFollowedUpAt']);
      allow create, delete: if false;
    }

    /** Server-only ledger for last logistics freight Diff → next SO. */
    match /customerFreightSettlements/{customerId} {
      allow read, write: if false;
    }
  }
}
