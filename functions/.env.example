# Copy to .env.yesweigh-service for local `firebase deploy --only functions`.
# CI sets ZOHO_ORGANIZATION_ID from GitHub Actions; ZOHO_WEBHOOK_SECRET is optional (empty skips signature checks).
ZOHO_ORGANIZATION_ID=your_zoho_org_id
ZOHO_WEBHOOK_SECRET=
# Same value as yesgatc YESWEIGH_EMBED_SECRET (optional; iframe still works without auto-login).
YESWEIGH_EMBED_SECRET=
# Meezan catalog copy (optional until Meezan ingestYesweighCatalog is deployed).
MEEZAN_CATALOG_WEBHOOK_URL=https://asia-south1-meezan-36e48.cloudfunctions.net/ingestYesweighCatalog
MEEZAN_CATALOG_WEBHOOK_SECRET=
# YesWeigh dealer login for api1.sanoft.com (server-only).
SANOFT_YESWEIGH_USERNAME=
SANOFT_YESWEIGH_PASSWORD=
# Sarvam AI (server-only — never put this in client code or git).
SARVAM_API_KEY=
